# ===== 사이트 =====
# 사이트 이름 (헤더/홈 제목). 빌드 시점에 인라인되므로 바꾸면 다시 빌드해야 한다.
NEXT_PUBLIC_SITE_NAME=배송조회
# 사이트 공개 URL (선택). 카카오톡/OG 미리보기용 metadataBase. 예: https://example.com
NEXT_PUBLIC_SITE_URL=
# 쿠팡 홈 바로가기 배너(페이지 상단/하단)가 연결될 쿠팡 파트너스 링크. 비우면 기본값(https://link.coupang.com/a/bQkvJ5)을 쓴다.
# http(s) 주소만 허용한다. 빌드 시점에 인라인되므로 바꾸면 다시 빌드해야 한다.
NEXT_PUBLIC_COUPANG_PARTNERS_URL=https://link.coupang.com/a/bQkvJ5

# ===== MongoDB =====
# 미설정이면 인메모리 저장소(개발용, 재시작 시 데이터 소실, 시작 시 경고 로그)를 쓴다.
MONGODB_URI=
# DB 이름 (기본 coupang_pe_kr). 컬렉션은 invoices 고정.
MONGODB_DB=coupang_pe_kr

# ===== 캐시 정책 (ms) =====
# ok 스냅샷이 이 시간 이내면 배송 조회 API 를 호출하지 않고 캐시를 쓴다. (기본 120000 = 2분)
CACHE_TTL_MS=120000
# not_found 스냅샷 캐시 시간. (기본 60000 = 1분)
NOT_FOUND_TTL_MS=60000
# 새로고침(?refresh=1)은 스냅샷이 이 시간보다 오래됐을 때만 반영된다. (기본 30000 = 30초)
MIN_FORCE_REFRESH_MS=30000
# 배송완료 스냅샷은 새로고침을 눌러도 이 시간 이내면 재조회하지 않는다. (기본 3600000 = 1시간)
DELIVERED_RECHECK_MS=3600000
# 수집 API 로 등록되지 않은 번호도 조회를 허용할지. false 면 미등록 번호는 배송 조회 API 호출 없이 "검색결과 없음".
ALLOW_UNREGISTERED_LOOKUP=true

# ===== 배송 조회 API (Delivery Tracker) =====
# https://console.tracker.delivery 에서 Client Id / Client Secret 을 발급받아 넣는다.
# 서버에서만 읽는 값이다. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것 (브라우저에 노출되면 누구나 키를 복사해 쿼터를 소진시킬 수 있다).
# Client Secret 은 비밀값이므로 .env.local 에만 두고 저장소·로그·화면·이슈에 남기지 말 것.
# 둘 중 하나라도 비어 있으면 조회는 "일시적으로 조회할 수 없습니다"가 되고 서버 로그에 경고가 1회 남는다.
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
# 택배사 ID. 쿠팡 로지스틱스는 kr.coupangls (기본)
DELIVERY_TRACKER_CARRIER_ID=kr.coupangls
# 요청 1회 타임아웃 (ms). 공식 권장 최대 15초. (기본 15000)
DELIVERY_TRACKER_TIMEOUT_MS=15000
# (개발/테스트 전용) GraphQL 엔드포인트 override. 로컬 목 서버로 화면을 확인할 때만 쓰고 운영에서는 비워 둔다.
# 기본: https://apis.tracker.delivery/graphql
DELIVERY_TRACKER_ENDPOINT=

# ===== NSV 백엔드 직접 조회 (pull) =====
# 사이트가 운송장번호로 NSV 백엔드 GraphQL(getTrackingSiteInvoice)에 직접 물어 상품명·수령인·받는주소·배송요청사항을 가져온다.
# NSV 가 마스킹한 공개 수준 정보만 오므로 인증은 없고, 사이트도 받은 값을 한 번 더 마스킹한다. 서버에서만 읽는 값이다.
# 업체(tenant)마다 NSV 백엔드가 따로 있으므로 GraphQL 엔드포인트를 쉼표·공백·줄바꿈으로 여러 개 적는다.
# 모든 엔드포인트에 병렬로 묻고, found 인 첫 응답(여러 개면 목록 순서상 앞쪽)을 쓴다. http(s) 주소만 허용하며 형식 오류 항목은 경고 후 건너뛴다.
# 비워 두면 이 기능은 꺼진다(NSV 를 호출하지 않고, 수집 API 로 받은 meta 만 쓴다). 바꾼 뒤에는 서버 재시작.
#   로컬: NSV_GRAPHQL_URLS=http://localhost:4000/graphql
#   운영 예 (HM_TREND / LUDA_DREAM / DGM):
#   NSV_GRAPHQL_URLS=http://222.116.74.234:40141/graphql,http://222.116.74.234:40107/graphql,http://222.116.74.234:40222/graphql
NSV_GRAPHQL_URLS=
# 엔드포인트 1곳당 타임아웃 (ms). 느리거나 죽은 업체 백엔드가 있어도 조회가 이 시간 이상 늦어지지 않는다. (기본 3000)
NSV_GRAPHQL_TIMEOUT_MS=3000
# NSV 에서 받아온 meta 를 다시 조회하지 않는 시간. 지나면 다시 조회해 갱신한다 (수집 API 로 들어온 meta 도 포함). (기본 600000 = 10분)
NSV_META_TTL_MS=600000
# NSV 가 "해당 번호 없음"으로 답한 번호를 다시 묻지 않는 시간 (음성 캐시). (기본 120000 = 2분)
NSV_META_NEGATIVE_TTL_MS=120000

# ===== API =====
# GET /api/track/* 의 IP당 분당 허용 횟수. (기본 30)
API_RATE_LIMIT_PER_MIN=30
# 수집 API(POST /api/invoices) 키. "operator:KEY" 를 쉼표로 구분. 미설정이면 수집 API 비활성(503). 선택 사항이다 —
# NSV_GRAPHQL_URLS 만 설정해도 상품명·주소·배송요청사항이 나오고, NSV 가 push 설정을 하면 pull 과 함께 쓸 수 있다.
# 예: INGEST_API_KEYS=nsv-main:change-me-long-random-1,nsv-sub:change-me-long-random-2
INGEST_API_KEYS=

# ===== 관리자 (/admin, Basic Auth) =====
ADMIN_USER=admin
# 필수. 미설정이면 /admin 은 비활성(503). 반드시 HTTPS 뒤에서 충분히 긴 값을 쓸 것.
ADMIN_PASSWORD=
